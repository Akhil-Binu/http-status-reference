---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const { title, description, canonicalPath, jsonLd, ogType = 'website' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://http.dev';
const canonicalUrl = `${site}${canonicalPath}`;
const ogImage = `${site}/og-image.svg`;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="HTTP Status Reference" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#12141a" />

  {jsonLdList.map((entry) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))}

  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <div id="offline-banner" class="offline-banner" role="status">You're offline — showing a cached copy of this page.</div>

  <header class="site-header">
    <div class="wrap">
      <a href="/" class="brand">
        <span class="mono">HTTP</span><span>Status Reference</span>
      </a>
      <nav class="header-nav" aria-label="Main Navigation">
        <a href="/" class={`nav-link ${canonicalPath === '/' ? 'active' : ''}`}>Codes</a>
        <a href="/guide" class={`nav-link ${canonicalPath === '/guide' ? 'active' : ''}`}>Decision Guide</a>
      </nav>
      <div class="header-search">
        <div class="search-combobox">
          <div class="search-input-row">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M7 12.5A5.5 5.5 0 1 0 7 1.5a5.5 5.5 0 0 0 0 11Zm6.5 1.5-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <input
              type="text"
              id="search-input"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-results"
              aria-autocomplete="list"
              aria-label="Search status codes by number, name, or symptom"
              placeholder="Search “502”, “redirect loop”, “login keeps failing”…"
              autocomplete="off"
              spellcheck="false"
            />
            <span class="search-kbd-hint" aria-hidden="true">/</span>
          </div>
          <ul id="search-results" role="listbox" aria-label="Search results" hidden></ul>
        </div>
      </div>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">
        <span id="theme-toggle-icon" aria-hidden="true">🌓</span>
      </button>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>HTTP Status Reference — a free, offline-capable developer reference.</span>
      <span class="footer-links">
        <a href="/">Codes</a> ·
        <a href="/guide">Decision Guide</a> ·
        <a href="https://www.rfc-editor.org/rfc/rfc9110.html" target="_blank" rel="noopener noreferrer">RFC 9110</a> ·
        <a href="/sitemap.xml">Sitemap</a>
      </span>
    </div>
  </footer>

  <script is:inline src="/scripts/theme.js"></script>
  <script is:inline src="/scripts/search.js"></script>
  <script is:inline src="/scripts/sw-register.js"></script>
</body>
</html>
